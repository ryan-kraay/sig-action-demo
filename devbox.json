{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "gitsign@0.13.0",
    "cosign@2.6.1",
    "bats@1.12.0"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "TERM=vt100 $PWD/wp.sh --formatter pretty --report-formatter junit -o $PWD/out || true"
      ]
    }
  }
}
